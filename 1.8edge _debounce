//Debounce code
module debounce #(parameter COUNT_MAX=4, WIDTH=3) (
    input clk,reset,noisy_in,
    output reg clean_out
);
    reg sync1,sync2;
    reg [WIDTH-1:0] count;
    always @(posedge clk) begin
        if(reset) begin
            sync1<=0; sync2<=0; count<=0; clean_out<=0;
        end else begin
            sync1<=noisy_in;
            sync2<=sync1;
            if(sync2==clean_out)
                count<=0;
            else if(count==COUNT_MAX-1) begin
                clean_out<=sync2;
                count<=0;
            end else
                count<=count+1'b1;
        end
    end
endmodule
//edge detect
module edge_detect(input clk,reset,signal_in, output reg rise_pulse);
    reg sync1,sync2,signal_d;
    always @(posedge clk) begin
        if(reset) begin
            sync1<=0; sync2<=0; signal_d<=0; rise_pulse<=0;
        end else begin
            sync1<=signal_in;
            sync2<=sync1;
            signal_d<=sync2;
            rise_pulse<=sync2 & ~signal_d;
        end
    end
endmodule
//testbench code
`timescale 1ns/1ps
module debounce_tb;
    reg clk=0,reset,noisy_in;
    wire clean_out,rise_pulse;
    debounce #(.COUNT_MAX(4),.WIDTH(3)) db(clk,reset,noisy_in,clean_out);
    edge_detect ed(clk,reset,clean_out,rise_pulse);
    always #5 clk=~clk;
    initial begin
        reset=1; noisy_in=0;
        repeat(3) @(negedge clk);
        reset=0;
        // Simulate contact bounce before a stable press.
        noisy_in=1; #7; noisy_in=0; #6; noisy_in=1; #5;
        noisy_in=0; #8; noisy_in=1;
        repeat(12) @(negedge clk);
        // Release with bounce.
        noisy_in=0; #6; noisy_in=1; #5; noisy_in=0;
        repeat(12) @(negedge clk);
        $finish;
    end
endmodule
