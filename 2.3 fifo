//Design code
module fifo #(parameter DATA_WIDTH=8, DEPTH=16, ADDR_WIDTH=4) (
    input clk, reset, wr_en, rd_en,
    input [DATA_WIDTH-1:0] data_in,
    output reg [DATA_WIDTH-1:0] data_out,
    output full, empty
);
    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];
    reg [ADDR_WIDTH-1:0] wr_ptr, rd_ptr;
    reg [ADDR_WIDTH:0] count;

    assign full = (count == DEPTH);
    assign empty = (count == 0);

    always @(posedge clk) begin
        if (reset) begin
            wr_ptr<=0; rd_ptr<=0; count<=0; data_out<=0;
        end else begin
            case ({wr_en && !full, rd_en && !empty})
                2'b10: begin
                    mem[wr_ptr] <= data_in;
                    wr_ptr <= wr_ptr + 1'b1;
                    count <= count + 1'b1;
                end
                2'b01: begin
                    data_out <= mem[rd_ptr];
                    rd_ptr <= rd_ptr + 1'b1;
                    count <= count - 1'b1;
                end
                2'b11: begin
                    // Simultaneous read/write: occupancy unchanged.
                    mem[wr_ptr] <= data_in;
                    data_out <= mem[rd_ptr];
                    wr_ptr <= wr_ptr + 1'b1;
                    rd_ptr <= rd_ptr + 1'b1;
                end
                default: begin end
            endcase
        end
    end
endmodule
//Testbench code
`timescale 1ns/1ps
module fifo_tb;
    reg clk=0,reset,wr_en,rd_en;
    reg [7:0] data_in;
    wire [7:0] data_out;
    wire full,empty;
    integer i;
    fifo dut(.*);
    always #5 clk=~clk;
    task cycle; begin @(negedge clk); end endtask
    initial begin
        reset=1; wr_en=0; rd_en=0; data_in=0; cycle(); reset=0;
        // Fill to full.
        for(i=0;i<16;i=i+1) begin wr_en=1; data_in=i; cycle(); end
        wr_en=0; #1; if(!full) $display("ERROR: FIFO did not become full");
        // Attempt write when full; must be ignored.
        wr_en=1; data_in=8'hEE; cycle(); wr_en=0;
        // Drain to empty.
        for(i=0;i<16;i=i+1) begin rd_en=1; cycle(); end
        rd_en=0; #1; if(!empty) $display("ERROR: FIFO did not become empty");
        // Attempt read when empty; must be ignored.
        rd_en=1; cycle(); rd_en=0;
        // Simultaneous read/write with one existing word.
        wr_en=1; data_in=8'hA5; cycle();
        wr_en=1; rd_en=1; data_in=8'h5A; cycle();
        wr_en=0; rd_en=1; cycle(); rd_en=0;
        $display("FIFO directed test completed.");
        $finish;
    end
endmodule

endmodule
