module arbiter(input clk, reset, input [3:0] req, output reg [3:0] grant);
    reg [1:0] priority_ptr;
    reg [1:0] chosen;
    reg found;
    integer k;
    reg [3:0] rotated_req;

    // A current grant is held until that request is deasserted.
    always @* begin
        chosen=priority_ptr;
        found=0;
        rotated_req=0;
        for(k=0;k<4;k=k+1) begin
            if(!found && req[(priority_ptr+k)%4]) begin
                chosen=(priority_ptr+k)%4;
                found=1;
            end
        end
    end

    always @(posedge clk) begin
        if(reset) begin grant<=0; priority_ptr<=0; end
        else if(grant!=0) begin
            if((grant & req)==0) begin
                grant<=0;
                priority_ptr<=chosen+1'b1;
            end
        end else if(found) begin
            grant<=4'b0001 << chosen;
        end
    end
endmodule
//Testbench code
`timescale 1ns/1ps
module arbiter_tb;
    reg clk=0,reset;
    reg [3:0] req;
    wire [3:0] grant;
    integer counts[0:3];
    integer i,cycles;
    arbiter dut(.*);
    always #5 clk=~clk;
    initial begin
        reset=1; req=0;
        for(i=0;i<4;i=i+1) counts[i]=0;
        repeat(2) @(negedge clk); reset=0; req=4'b1111;
        // Keep each request asserted for a grant, then release the winner.
        for(cycles=0;cycles<40;cycles=cycles+1) begin
            @(negedge clk);
            if(grant!=0) begin
                for(i=0;i<4;i=i+1) if(grant[i]) counts[i]=counts[i]+1;
                req=req & ~grant;
            end
            if(req==0) req=4'b1111;
        end
        $display("Grant counts: %0d %0d %0d %0d",counts[0],counts[1],counts[2],counts[3]);
        if(counts[0]!=counts[1] || counts[1]!=counts[2] || counts[2]!=counts[3])
            $display("FAIRNESS CHECK FAILED");
        else $display("FAIRNESS CHECK PASSED");
        $finish;
    end
endmodule


