//Encoder
module priority_encoder_casez(input [7:0] in, output reg [2:0] code, output reg valid);
    always @* begin
        valid=1'b1;
        casez (in)
            8'b1???????: code=3'd7;
            8'b01??????: code=3'd6;
            8'b001?????: code=3'd5;
            8'b0001????: code=3'd4;
            8'b00001???: code=3'd3;
            8'b000001??: code=3'd2;
            8'b0000001?: code=3'd1;
            8'b00000001: code=3'd0;
            default: begin code=3'd0; valid=1'b0; end
        endcase
    end
endmodule

module priority_encoder_if(input [7:0] in, output reg [2:0] code, output reg valid);
    always @* begin
        valid=1'b1;
        if(in[7]) code=7;
        else if(in[6]) code=6;
        else if(in[5]) code=5;
        else if(in[4]) code=4;
        else if(in[3]) code=3;
        else if(in[2]) code=2;
        else if(in[1]) code=1;
        else if(in[0]) code=0;
        else begin code=0; valid=0; end
    end
endmodule
//Decoder
module decoder(input [2:0] in, input enable, output reg [7:0] out);
    always @* begin
        out=8'b0;
        if(enable) out = 8'b00000001 << in;
    end
endmodule
//Testbench code
`timescale 1ns/1ps
module encoder_decoder_tb;
    reg [7:0] in;
    reg [2:0] dec_in;
    reg enable;
    wire [2:0] code1,code2;
    wire valid1,valid2;
    wire [7:0] dec_out;
    integer i;
    priority_encoder_casez e1(in,code1,valid1);
    priority_encoder_if e2(in,code2,valid2);
    decoder d1(dec_in,enable,dec_out);
    initial begin
        for(i=0;i<256;i=i+1) begin
            in=i; #1;
            if(code1!==code2 || valid1!==valid2)
                $display("Encoder mismatch for input %b",in);
        end
        for(i=0;i<8;i=i+1) begin
            dec_in=i; enable=1; #1;
            if(dec_out !== (8'b1 << i)) $display("Decoder error at %0d",i);
            enable=0; #1;
            if(dec_out !== 0) $display("Decoder enable error");
        end
        $display("Encoder versions simulate identically for all 256 binary inputs.");
        $finish;
    end
endmodule
