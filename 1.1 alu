//Design code
module alu #(parameter WIDTH = 32)
(
    input  [WIDTH-1:0] A,
    input  [WIDTH-1:0] B,
    input  [2:0] ALU_Sel,

    output reg [WIDTH-1:0] Result,
    output reg zero,
    output reg negative,
    output reg carry,
    output reg overflow
);

reg [WIDTH:0] temp;

always @(*) begin

    Result   = 0;
    zero     = 0;
    negative = 0;
    carry    = 0;
    overflow = 0;
    temp     = 0;

    case(ALU_Sel)

        // ADD
        3'b000: begin
            temp = {1'b0,A} + {1'b0,B};
            Result = temp[WIDTH-1:0];
            carry = temp[WIDTH];

            overflow = (~(A[WIDTH-1] ^ B[WIDTH-1])) &
                       (Result[WIDTH-1] ^ A[WIDTH-1]);
        end

        // SUB
        3'b001: begin
            temp = {1'b0,A} - {1'b0,B};
            Result = temp[WIDTH-1:0];
            carry = (A >= B);

            overflow = (A[WIDTH-1] ^ B[WIDTH-1]) &
                       (Result[WIDTH-1] ^ A[WIDTH-1]);
        end

        // AND
        3'b010: begin
            Result = A & B;
        end

        // OR
        3'b011: begin
            Result = A | B;
        end

        // XOR
        3'b100: begin
            Result = A ^ B;
        end

        // SLT (Signed comparison)
        3'b101: begin
            Result = ($signed(A) < $signed(B)) ? 1 : 0;
        end

        // SLL (Logical left shift)
        3'b110: begin
            Result = A << B[$clog2(WIDTH)-1:0];
        end

        // SRL (Logical right shift)
        3'b111: begin
            Result = A >> B[$clog2(WIDTH)-1:0];
        end

    endcase

    zero = (Result == 0);
    negative = Result[WIDTH-1];

end
endmodule
// Testbench code

module alu_tb;

parameter WIDTH = 32;

reg [WIDTH-1:0] A, B;
reg [2:0] ALU_Sel;

wire [WIDTH-1:0] Result;
wire zero, negative, carry, overflow;

integer i;

alu #(WIDTH) uut (
    .A(A),
    .B(B),
    .ALU_Sel(ALU_Sel),
    .Result(Result),
    .zero(zero),
    .negative(negative),
    .carry(carry),
    .overflow(overflow)
);

task test;
input [WIDTH-1:0] x;
input [WIDTH-1:0] y;
input [2:0] op;
begin
    A = x;
    B = y;
    ALU_Sel = op;
    #10;

    $display("A=%h B=%h OP=%b Result=%h Z=%b N=%b C=%b V=%b",
             A, B, ALU_Sel, Result,
             zero, negative, carry, overflow);
end
endtask

initial begin

    $dumpfile("alu.vcd");
    $dumpvars(0, alu_tb);

    $display("--------- ALU TEST START ---------");

    // ADD tests
    test(0, 0, 3'b000);
    test(10, 20, 3'b000);
    test(32'hFFFFFFFF, 1, 3'b000);
    test(32'h7FFFFFFF, 1, 3'b000);
    test(32'h80000000, 32'h80000000, 3'b000);

    // SUB tests
    test(20, 10, 3'b001);
    test(10, 20, 3'b001);
    test(0, 0, 3'b001);
    test(32'h80000000, 1, 3'b001);
    test(32'h7FFFFFFF, 32'hFFFFFFFF, 3'b001);

    // AND tests
    test(32'hFFFFFFFF, 32'h0F0F0F0F, 3'b010);
    test(32'hAAAAAAAA, 32'h55555555, 3'b010);
    test(0, 32'hFFFFFFFF, 3'b010);
    test(15, 10, 3'b010);

    // OR tests
    test(32'hAAAAAAAA, 32'h55555555, 3'b011);
    test(0, 0, 3'b011);
    test(32'h12345678, 32'h0000FFFF, 3'b011);
    test(10, 20, 3'b011);

    // XOR tests
    test(32'hFFFFFFFF, 32'hFFFFFFFF, 3'b100);
    test(32'hAAAAAAAA, 32'h55555555, 3'b100);
    test(0, 0, 3'b100);
    test(15, 10, 3'b100);

    // SLT tests
    test(10, 20, 3'b101);
    test(20, 10, 3'b101);
    test(32'hFFFFFFFF, 1, 3'b101);
    test(32'h80000000, 32'h7FFFFFFF, 3'b101);

    // SLL tests
    test(1, 1, 3'b110);
    test(1, 4, 3'b110);
    test(32'h80000000, 1, 3'b110);
    test(32'hFFFFFFFF, 4, 3'b110);

    // SRL tests
    test(32'h80000000, 1, 3'b111);
    test(32'hFFFFFFFF, 4, 3'b111);
    test(32'h12345678, 8, 3'b111);
    test(0, 1, 3'b111);

    // Additional corner cases
    test(32'h7FFFFFFF, 1, 3'b000);
    test(32'hFFFFFFFF, 32'hFFFFFFFF, 3'b000);
    test(32'h80000000, 32'hFFFFFFFF, 3'b001);
    test(32'h00000001, 32'h00000001, 3'b001);

    #10;
    $display("--------- ALU TEST COMPLETE ---------");
    $finish;

end

endmodule

endmodule
