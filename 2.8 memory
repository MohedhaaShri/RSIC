//RAM
module ram(input clk, input we, input [3:0] addr,
           input [7:0] data_in, output reg [7:0] data_out);
    reg [7:0] mem[0:15];
    always @(posedge clk) begin
        if(we) mem[addr] <= data_in;
        data_out <= mem[addr];
    end
endmodule
//Rom
module rom #(parameter INIT_FILE="rom.hex") (
    input clk, input [3:0] addr, output reg [7:0] data_out
);
    reg [7:0] mem[0:15];
    initial $readmemh(INIT_FILE,mem);
    always @(posedge clk) data_out <= mem[addr];
endmodule
//Watchdog Design code
module watchdog #(parameter TIMEOUT=8, WIDTH=4, PULSE_CYCLES=1) (
    input clk, reset, kick,
    output reg reset_pulse
);
    reg [WIDTH-1:0] count;
    reg [1:0] pulse_count;
    always @(posedge clk) begin
        if(reset) begin count<=0; reset_pulse<=0; pulse_count<=0; end
        else begin
            if(kick) begin count<=0; reset_pulse<=0; pulse_count<=0; end
            else if(reset_pulse) begin
                if(pulse_count==PULSE_CYCLES-1) begin
                    reset_pulse<=0; pulse_count<=0; count<=0;
                end else pulse_count<=pulse_count+1'b1;
            end else if(count==TIMEOUT-1) begin
                reset_pulse<=1; pulse_count<=0; count<=0;
            end else count<=count+1'b1;
        end
    end
endmodule
//Testbench code
`timescale 1ns/1ps
module memory_watchdog_tb;
    reg clk=0,we,wd_reset,kick;
    reg [3:0] addr;
    reg [7:0] data_in;
    wire [7:0] ram_out,rom_out;
    wire reset_pulse;
    ram r(clk,we,addr,data_in,ram_out);
    rom #(.INIT_FILE("rom.hex")) ro(clk,addr,rom_out);
    watchdog #(.TIMEOUT(6),.WIDTH(3),.PULSE_CYCLES(1)) w(clk,wd_reset,kick,reset_pulse);
    always #5 clk=~clk;
    initial begin
        we=0; wd_reset=1; kick=0; addr=0; data_in=0;
        @(negedge clk); wd_reset=0;
        // RAM write/read
        we=1; addr=4; data_in=8'hA6; @(negedge clk);
        we=0; @(negedge clk);
        // Allow watchdog to timeout.
        repeat(8) @(negedge clk);
        // Kick periodically to prevent another timeout.
        kick=1; @(negedge clk); kick=0;
        repeat(4) @(negedge clk);
        kick=1; @(negedge clk); kick=0;
        repeat(4) @(negedge clk);
        $finish;
    end
endmodule


